---
const { mode = 'hero' } = Astro.props;
const isCompact = mode === 'compact';
---

<div class={`tagline-card ${isCompact ? 'tagline-card-compact' : 'tagline-card-hero'}`}>
  {isCompact ? (
    <div class="tagline-compact-content">
      <span class="tagline-discipline">Pharmacometrics</span>
      <span class="tagline-separator">·</span>
      <span class="tagline-discipline">Statistics</span>
      <span class="tagline-separator">·</span>
      <span class="tagline-discipline">ML</span>
      <span class="tagline-separator">·</span>
      <span class="tagline-discipline">Topology Optimization</span>
    </div>
  ) : (
    <span class="tagline-text">Pharmacometrics, Statistics, Machine Learning and Topology Optimization</span>
  )}
</div>

<style>
  /* Base styles */
  .tagline-card {
    display: inline-flex;
    align-items: center;
    transition: all 300ms ease;
  }

  /* Hero mode (home page) - larger, more prominent */
  .tagline-card-hero {
    padding: 0.75rem 1.5rem;
    background: linear-gradient(
      135deg,
      oklch(55% 0.12 250 / 0.1) 0%,
      oklch(55% 0.12 280 / 0.08) 100%
    );
    border: 1px solid oklch(55% 0.12 250 / 0.15);
    border-radius: 1rem;
    backdrop-filter: blur(8px);
  }

  .tagline-card-hero:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px oklch(55% 0.12 250 / 0.15);
    border-color: oklch(55% 0.12 250 / 0.25);
  }

  .tagline-card-hero .tagline-text {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-primary, #4a6cf7);
    letter-spacing: 0.02em;
    white-space: normal;
    line-height: 1.5;
  }

  /* Compact mode (sidebar) - smaller, subtler */
  .tagline-card-compact {
    padding: 0.5rem 0.75rem;
    background: oklch(60% 0.1 250 / 0.08);
    border: 1px solid oklch(60% 0.1 250 / 0.12);
    border-radius: 0.5rem;
  }

  .tagline-card-compact:hover {
    background: oklch(60% 0.1 250 / 0.12);
    border-color: oklch(60% 0.1 250 / 0.2);
  }

  .tagline-card-compact .tagline-text {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-text-muted, oklch(60% 0.05 260));
    letter-spacing: 0.01em;
    white-space: normal;
    line-height: 1.4;
    text-align: center;
  }

  /* Compact mode - stacked layout */
  .tagline-compact-content {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.25rem 0.375rem;
    font-size: 0.8rem;
    line-height: 1.3;
  }

  .tagline-discipline {
    color: var(--color-text-muted, oklch(70% 0.04 260));
    font-weight: 500;
    white-space: nowrap;
  }

  .tagline-separator {
    color: oklch(60% 0.08 250 / 0.5);
    font-weight: 600;
    font-size: 0.75rem;
  }

  @media (max-width: 768px) {
    .tagline-card-hero {
      padding: 0.625rem 1.25rem;
    }

    .tagline-card-hero .tagline-text {
      font-size: 0.9375rem;
    }

    .tagline-card-compact {
      padding: 0.4rem 0.625rem;
    }

    .tagline-card-compact .tagline-text {
      font-size: 0.7rem;
    }

    .tagline-compact-content {
      font-size: 0.75rem;
      gap: 0.2rem 0.3rem;
    }

    .tagline-separator {
      font-size: 0.7rem;
    }
  }
</style>
