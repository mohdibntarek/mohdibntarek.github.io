---
// Theme Toggle Component - Alpine.js version
---

<button 
  id="theme-toggle" 
  class="theme-toggle" 
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
  x-data="themeToggle()"
  @click="toggle()"
>
  <!-- Sun icon - visible in dark mode (click to switch to light) -->
  <span class="theme-toggle__icon theme-toggle__icon--sun" :class="{ 'visible': isDark }">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="5"></circle>
      <line x1="12" y1="1" x2="12" y2="3"></line>
      <line x1="12" y1="21" x2="12" y2="23"></line>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
      <line x1="1" y1="12" x2="3" y2="12"></line>
      <line x1="21" y1="12" x2="23" y2="12"></line>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
    </svg>
  </span>
  
  <!-- Moon icon - visible in light mode (click to switch to dark) -->
  <span class="theme-toggle__icon theme-toggle__icon--moon" :class="{ 'visible': !isDark }">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
  </span>
</button>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 50%;
    background: var(--color-card);
    color: var(--color-text);
    cursor: pointer;
    transition: all 250ms ease;
    box-shadow: 0 2px 8px var(--shadow-color);
    position: fixed;
    bottom: 1.25rem;
    right: 1.25rem;
    z-index: 1000;
    overflow: hidden;
  }

  .theme-toggle:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px var(--shadow-color-hover);
    background: var(--color-card-hover);
  }

  .theme-toggle:active {
    transform: translateY(0);
  }

  .theme-toggle__icon {
    position: absolute;
    pointer-events: none;
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
    transition: opacity 250ms ease, transform 250ms ease;
  }

  .theme-toggle__icon.visible {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
</style>