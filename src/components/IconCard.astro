---
const { href = "", icon = "", path = "" } = Astro.props;
---

{
  href ? (
    <a class="icon-card" href={href} target="_blank" rel="noopener noreferrer">
      <div class="icon-wrapper">
        {path ? <img src={path.src || path} alt="" /> : <Fragment set:html={icon.html} />}
      </div>
      <span class="label">
        <slot />
      </span>
    </a>
  ) : (
    <div class="icon-card">
      <div class="icon-wrapper">
        <Fragment set:html={icon.html} />
      </div>
      <span class="label">
        <slot />
      </span>
    </div>
  )
}

<style>
  .icon-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.875rem;
    border-radius: 0.75rem;
    color: oklch(98% 0.025 145 / 0.95);
    text-decoration: none;
    transition: all 250ms cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .icon-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      oklch(100% 0.02 145 / 0.15) 0%,
      oklch(100% 0.02 145 / 0.05) 100%
    );
    opacity: 0;
    transition: opacity 250ms ease;
  }

  .icon-card:hover::before {
    opacity: 1;
  }

  .icon-card:hover {
    background: oklch(100% 0.02 145 / 0.1);
    transform: translateX(4px);
  }

  .icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .icon-wrapper :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .icon-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: brightness(1.2);
  }

  .label {
    font-size: 0.9375rem;
    font-weight: 500;
    position: relative;
    z-index: 1;
    transition: color 250ms ease;
  }

  .icon-card:hover .label {
    color: oklch(100% 0.02 145 / 1);
  }

  /* Active state */
  .icon-card:active {
    transform: translateX(2px);
  }

  /* Focus styles */
  .icon-card:focus-visible {
    outline: 2px solid oklch(60% 0.15 250);
    outline-offset: 2px;
  }
</style>