---
import Layout from "../layouts/Layout.astro";
import ContentList from "../components/ContentList.astro";
import teaching from "../data/teaching.json";

const frontmatter = {
  title: "Teaching",
  description: "Courses, workshops, and tutorials",
  published: true,
  "number-sections": true,
};
---

<Layout frontmatter={frontmatter}>
  <div id="teaching-search">
    <div class="search-container">
      <input
        type="text"
        id="teaching-query"
        placeholder="Search courses, workshops, videos, and tutorials..."
        class="search-input"
      />
      <button id="teaching-clear" class="search-clear" aria-label="Clear search" hidden>&times;</button>
    </div>

    <p id="teaching-no-results" class="no-results" hidden>No courses, workshops, or tutorials matching your search.</p>

    <ContentList sections={teaching.sections} />
  </div>
</Layout>

<script>
  function fuzzy(text: string, pattern: string): boolean {
    text = text.toLowerCase();
    pattern = pattern.toLowerCase();
    if (text.includes(pattern)) return true;
    if (pattern.length < 3) return false;
    let ti = 0, pi = 0, gaps = 0;
    while (ti < text.length && pi < pattern.length) {
      if (text[ti] === pattern[pi]) { pi++; }
      else if (pi > 0) { gaps++; }
      ti++;
    }
    return pi === pattern.length && gaps <= Math.floor(pattern.length / 3);
  }

  function matchesItem(el: HTMLElement, tokens: string[]): boolean {
    const { title = '', venue = '', date = '', status = '', tags = '', links = '' } = el.dataset;
    return tokens.every(token => {
      const aliases = token === 'video' ? ['youtube'] : token === 'paper' ? ['paper', 'journal'] : [token];
      return fuzzy(title, token) ||
        fuzzy(venue, token) ||
        fuzzy(status, token) ||
        date.toLowerCase().includes(token) ||
        aliases.some(a => links.split(',').some(l => fuzzy(l, a))) ||
        tags.split(',').some(t => fuzzy(t, token));
    });
  }

  function filterTeaching() {
    const input = document.getElementById('teaching-query') as HTMLInputElement;
    const clearBtn = document.getElementById('teaching-clear') as HTMLButtonElement;
    const noResults = document.getElementById('teaching-no-results') as HTMLElement;
    const sections = document.querySelectorAll<HTMLElement>('#teaching-search [data-section]');

    const q = input.value.trim();
    const tokens = q.toLowerCase().split(/\s+/).filter(Boolean);

    clearBtn.hidden = !q;

    let anyVisible = false;

    sections.forEach(section => {
      const items = section.querySelectorAll<HTMLElement>('li[data-title]');
      let sectionHasVisible = false;
      items.forEach(li => {
        const visible = !q || matchesItem(li, tokens);
        li.hidden = !visible;
        if (visible) sectionHasVisible = true;
      });
      section.hidden = !sectionHasVisible;
      if (sectionHasVisible) anyVisible = true;
    });

    noResults.hidden = !q || anyVisible;
  }

  function initSearch() {
    const input = document.getElementById('teaching-query') as HTMLInputElement | null;
    const clearBtn = document.getElementById('teaching-clear') as HTMLButtonElement | null;
    if (!input || !clearBtn) return;
    input.value = '';
    filterTeaching();
    input.addEventListener('input', filterTeaching);
    clearBtn.addEventListener('click', () => {
      input.value = '';
      filterTeaching();
    });
  }

  initSearch();
  document.addEventListener('astro:page-load', initSearch);
</script>

<style>
  .search-container {
    position: relative;
    margin-bottom: 2rem;
    max-width: 100%;
    overflow: hidden;
  }

  .search-input {
    box-sizing: border-box;
    width: 100%;
    padding: 0.75rem 1rem;
    padding-right: 2.5rem;
    font-size: 1rem;
    font-family: inherit;
    border: 1px solid var(--color-card-border, #e5e5e5);
    border-radius: 8px;
    background: var(--color-card, #ffffff);
    color: var(--color-text, #1a1a1a);
    outline: none;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }

  .search-input:focus {
    border-color: var(--color-primary, #667eea);
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
  }

  .search-input::placeholder {
    color: var(--color-text-secondary, #999);
  }

  .search-clear {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    font-size: 1.25rem;
    color: var(--color-text-secondary, #999);
    cursor: pointer;
    line-height: 1;
    padding: 0.25rem;
  }

  .search-clear:hover {
    color: var(--color-text, #1a1a1a);
  }

  .no-results {
    color: var(--color-text-secondary, #666);
    font-style: italic;
    margin: 2rem 0;
  }
</style>