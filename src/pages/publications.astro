---
import Layout from "../layouts/Layout.astro";
import publications from "../data/publications.json";

const frontmatter = {
  title: "Research and Teaching",
  description: "Publications and workshops taught",
  published: true,
};
---

<Layout frontmatter={frontmatter}>
  <div id="pub-search">
    <div class="search-container">
      <input
        type="text"
        id="pub-query"
        placeholder="Search publications by title, venue, year..."
        class="search-input"
      />
      <button id="pub-clear" class="search-clear" aria-label="Clear search" hidden>&times;</button>
    </div>

    <p id="pub-no-results" class="no-results" hidden>No publications matching your search.</p>

    {publications.sections.map((section, sIdx) => (
      <div data-section>
        <h2><span class="heading-number">{sIdx + 1}.</span> {section.title}</h2>
        <ol>
          {section.items.map((item) => (
            <li
              data-title={item.title}
              data-venue={item.venue}
              data-year={String(item.year)}
              data-status={item.status || ''}
              data-tags={(item.tags || []).join(',')}
              data-links={item.links.map(l => l.label).join(',')}
            >
              <strong>{item.title}</strong>{item.venue && <span>, {item.venue}</span>}{item.date && <span>. {item.date}</span>}{item.status && <span>. {item.status}</span>}{item.status && '.'}
              {item.links.map((link) => (
                <span>
                  &nbsp;[<a href={link.url} target="_blank" rel="noopener">{link.label}</a>]
                </span>
              ))}
            </li>
          ))}
        </ol>
      </div>
    ))}
  </div>

</Layout>

<script>
  function fuzzy(text: string, pattern: string): boolean {
    text = text.toLowerCase();
    pattern = pattern.toLowerCase();
    if (text.includes(pattern)) return true;
    if (pattern.length < 3) return false;
    let ti = 0, pi = 0, gaps = 0;
    while (ti < text.length && pi < pattern.length) {
      if (text[ti] === pattern[pi]) { pi++; }
      else if (pi > 0) { gaps++; }
      ti++;
    }
    return pi === pattern.length && gaps <= Math.floor(pattern.length / 3);
  }

  function matchesItem(el: HTMLElement, tokens: string[]): boolean {
    const { title = '', venue = '', year = '', status = '', tags = '', links = '' } = el.dataset;
    return tokens.every(token => {
      const aliases = token === 'video' ? ['youtube'] : token === 'paper' ? ['paper', 'journal'] : [token];
      return fuzzy(title, token) ||
        fuzzy(venue, token) ||
        fuzzy(status, token) ||
        year.includes(token) ||
        aliases.some(a => links.split(',').some(l => fuzzy(l, a))) ||
        tags.split(',').some(t => fuzzy(t, token));
    });
  }

  function filterPublications() {
    const input = document.getElementById('pub-query') as HTMLInputElement;
    const clearBtn = document.getElementById('pub-clear') as HTMLButtonElement;
    const noResults = document.getElementById('pub-no-results') as HTMLElement;
    const sections = document.querySelectorAll<HTMLElement>('#pub-search [data-section]');

    const q = input.value.trim();
    const tokens = q.toLowerCase().split(/\s+/).filter(Boolean);

    clearBtn.hidden = !q;

    let anyVisible = false;

    sections.forEach(section => {
      const items = section.querySelectorAll<HTMLElement>('li[data-title]');
      let sectionHasVisible = false;
      items.forEach(li => {
        const visible = !q || matchesItem(li, tokens);
        li.hidden = !visible;
        if (visible) sectionHasVisible = true;
      });
      section.hidden = !sectionHasVisible;
      if (sectionHasVisible) anyVisible = true;
    });

    noResults.hidden = !q || anyVisible;
  }

  const input = document.getElementById('pub-query')!;
  const clearBtn = document.getElementById('pub-clear')!;
  input.addEventListener('input', filterPublications);
  clearBtn.addEventListener('click', () => {
    (input as HTMLInputElement).value = '';
    filterPublications();
  });
</script>

<style>
  .search-container {
    position: relative;
    margin-bottom: 2rem;
    max-width: 100%;
    overflow: hidden;
  }

  .search-input {
    box-sizing: border-box;
    width: 100%;
    padding: 0.75rem 1rem;
    padding-right: 2.5rem;
    font-size: 1rem;
    font-family: inherit;
    border: 1px solid var(--color-card-border, #e5e5e5);
    border-radius: 8px;
    background: var(--color-card, #ffffff);
    color: var(--color-text, #1a1a1a);
    outline: none;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }

  .search-input:focus {
    border-color: var(--color-primary, #667eea);
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
  }

  .search-input::placeholder {
    color: var(--color-text-secondary, #999);
  }

  .search-clear {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    font-size: 1.25rem;
    color: var(--color-text-secondary, #999);
    cursor: pointer;
    line-height: 1;
    padding: 0.25rem;
  }

  .search-clear:hover {
    color: var(--color-text, #1a1a1a);
  }

  .no-results {
    color: var(--color-text-secondary, #666);
    font-style: italic;
    margin: 2rem 0;
  }
</style>
